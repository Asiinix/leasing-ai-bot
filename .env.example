# Live public reference APIs; use snapshot for an offline summit rehearsal.
COLVIR_MODE=live

# AI assistant (server only, never exposed to the browser). Without a key or with an
# unavailable model the chat works in a simplified deterministic mode.
OPENAI_API_KEY=
# Optional overrides.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Where submitted applications are stored (JSON file). Default: .data/applications.json.
# On Railway the filesystem is ephemeral — mount a volume or connect a real store.
APPLICATIONS_FILE=

# Сохраненные фото и цены каталога (по умолчанию .data/vehicle-market.json)
# VEHICLE_MARKET_FILE=
