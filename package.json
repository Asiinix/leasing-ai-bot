{
  "name": "bcc-leasing-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feature": "node scripts/features.mjs",
    "build:design-system": "node scripts/build-design-system.mjs",
    "prebuild": "npm run build:design-system",
    "predev": "npm run build:design-system"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "bcc-design": "file:vendor/bcc-design",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
